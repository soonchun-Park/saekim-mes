function rsBackupPage(db,m,p){rsVerifyManifest(p.manifest);if(p.manifest.generation!==m.generation||p.manifest.revision!==m.revision)throw Error('백업 도중 데이터 변경 · 처음부터 다시 백업');var spec=p.manifest.tables.find(function(t){return t.name===p.table;});if(!spec)throw Error('백업 table 오류');var cursor=p.cursor||0,limit=p.limit||RS_PAGE;integer(cursor,'백업 cursor');integer(limit,'백업 limit',1);if(limit>RS_PAGE||cursor>spec.count)throw Error('백업 범위 오류');var records=[];records=rsRowsAt(db,p.table,m.generation,cursor+1,Math.min(spec.count,cursor+limit)).map(function(r){return {id:r.id,parent:r.parent,seq:r.seq,record:r.record};});var page={table:p.table,cursor:cursor,nextCursor:cursor+records.length<spec.count?cursor+records.length:null,total:spec.count,records:records};page.sha256=rsHash(rsJson(page));return page;}
