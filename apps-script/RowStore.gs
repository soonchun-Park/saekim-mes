function rsRestorePage(db,m,p){var session=rsRestoreSession(m,p.sessionId),page=p.page,copy=clone(page),hash=copy.sha256;delete copy.sha256;if(rsHash(rsJson(copy))!==hash)throw Error('복원 page 체크섬 오류');var spec=session.manifest.tables.find(function(t){return t.name===page.table;});if(!spec||page.total!==spec.count||!Array.isArray(page.records)||page.records.length>RS_PAGE||page.cursor<0)throw Error('복원 page 범위 오류');var pageKey=page.table+':'+page.cursor;var seen=rsFind(db,'RestorePages',session.generation,pageKey);if(seen){if(seen.record.hash!==hash)throw Error('복원 page 중복 충돌');return {ok:true,nextCursor:page.nextCursor};}if(page.cursor!==session.counts[page.table]||page.records.some(function(r,i){return r.seq!==page.cursor+i+1;}))throw Error('복원 page 순서 오류');if(page.records.length===0&&spec.count>0)throw Error('빈 복원 page');if(page.nextCursor!==(page.cursor+page.records.length<spec.count?page.cursor+page.records.length:null))throw Error('복원 다음 cursor 오류');var pending={},records=page.records.map(function(r){rsRestoreRecord(db,session,page.table,r,pending);pending[page.table+':'+r.id]=r;return {table:page.table,id:r.id,parent:r.parent,record:r.record,seq:r.seq};});var next=clone(m);records.push({table:'RestorePages',id:pageKey,parent:'',record:{hash:hash}});if(records.length)rsCommit(db,m,session.generation,records,next,'restore-page:'+p.sessionId+':'+pageKey);else rsSetMeta(db,next);return {ok:true,nextCursor:page.nextCursor};}
function rsRestoreValidate(db,m,p){var session=rsRestoreSession(m,p.sessionId),kind=p.kind;if(['quotes','orders'].indexOf(kind)<0)throw Error('복원 검증 종류 오류');if(session.manifest.tables.some(function(t){return session.counts[t.name]!==t.count;}))throw Error('복원 page 누락');var cursor=p.cursor||0,limit=p.limit||RS_PAGE;integer(cursor,'검증 cursor');integer(limit,'검증 limit',1);if(limit>RS_PAGE)throw Error('검증 최대 25개');var expected=session.validation[kind],total=session.counts[kind==='quotes'?'Quotes':'Orders'];if(cursor<expected)return {ok:true,nextCursor:expected<total?expected:null,total:total,done:expected===total};if(cursor!==expected)throw Error('검증 page 순서 오류');for(var n=cursor+1;n<=Math.min(total,cursor+limit);n++){var r=rsAt(db,kind==='quotes'?'Quotes':'Orders',session.generation,n),s=empty();if(kind==='quotes'){var q=rsQuote(db,session.generation,r.id);s.quotes=rsFamily(db,session.generation,q.familyId);}else{var o=rsOrder(db,session.generation,r.id);s.orders=[o];s.quotes=rsFamily(db,session.generation,o.snapshot.familyId);}validateState(s);}var next=clone(m);next.restore.validation[kind]=Math.min(total,cursor+limit);rsSetMeta(db,next);return {ok:true,nextCursor:next.restore.validation[kind]<total?next.restore.validation[kind]:null,total:total,done:next.restore.validation[kind]===total};}
function rsRestorePublish(db,m,p){if(m.lastRestore&&m.lastRestore.id===p.sessionId&&m.lastRestore.baseRevision===p.revision)return {ok:true,revision:m.revision,generation:m.generation,replayed:true};var s=rsRestoreSession(m,p.sessionId);if(p.revision!==m.revision)throw Error('복원 발행 revision 충돌');if(m.ancestors.length>=16)throw Error('복원 세대 한도 · 보관/정리 설계 필요');if(!s.publishReady){if(s.validation.quotes!==s.counts.Quotes||s.validation.orders!==s.counts.Orders||s.manifest.tables.some(function(t){return s.counts[t.name]!==t.count;}))throw Error('복원 검증 미완료');var staged=clone(m),audit={id:'restore-audit-'+rsHash(s.id).slice(0,24),type:'restore',key:s.id,time:new Date().toISOString(),revision:m.revision+1};staged.restore.publishReady=true;staged.restore.publicationAudit=audit;m=rsCommit(db,m,s.generation,[{table:'Audit',id:audit.id,parent:'',record:audit}],staged,'publish-audit:'+s.id);s=m.restore;}var next=clone(m);next.generation=s.generation;next.counts=clone(s.counts);next.revision=m.revision+1;next.ancestors=[m.generation].concat(m.ancestors);next.lastRestore={id:s.id,baseRevision:s.baseRevision};next.restore=null;next.pending=null;next.lastAudit=s.publicationAudit;try{rsSetMeta(db,next);}catch(e){e.errorCode='COMMIT_UNCERTAIN';e.retryable=true;throw e;}return {ok:true,revision:next.revision,generation:next.generation};}
