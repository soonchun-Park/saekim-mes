function rejectLocalProduction(action,payload){var p=payload||{};if(action==='command'&&['assignProduction','documentIssue','documentRevise','assignmentCancel','assignmentReplace'].indexOf(p.type)>=0){var e=Error('Production assignments and versioned documents are supported in local test mode only; Google row storage and supplier verification are not implemented.');e.errorCode='UNSUPPORTED_FEATURE';throw e;}var stack=[p],visited=0;while(stack.length){var value=stack.pop();if(!value||typeof value!=='object')continue;if(++visited>20000)throw Error('Request structure too large');if(Object.prototype.hasOwnProperty.call(value,'executionAssignments')||Object.prototype.hasOwnProperty.call(value,'productionDocuments')){var e=Error('Managed production records cannot be imported into Google test storage; use local test mode.');e.errorCode='UNSUPPORTED_FEATURE';throw e;}Object.keys(value).forEach(function(k){if(value[k]&&typeof value[k]==='object')stack.push(value[k]);});}}
