function gateway(action,payload){RS_CACHE={index:{},raw:{}};var lock=LockService.getScriptLock(),held=false,stage='read';try{lock.waitLock(20000);held=true;var db=rsBook(),p=payload||{};if(action==='initializeTestStore'){stage='validate';return {ok:true,meta:rsInitialize(db),mode:'google-test'};}var m=rsRecover(db,rsMeta(db));if(action==='state')return {ok:true,state:rsState(db,m,p),revision:m.revision,mode:'google-test'};if(action==='page')return rsPage(db,m,p);if(action==='read'){if(p.revision!==undefined&&p.revision!==m.revision)throw Error('조회 revision 충돌');return {ok:true,item:p.kind==='quotes'?rsDecorateQuote(db,m.generation,rsQuote(db,m.generation,p.id)):p.kind==='orders'?rsOrder(db,m.generation,p.id):null,revision:m.revision};}if(action==='backupManifest')return {ok:true,manifest:rsManifest(m),revision:m.revision};if(action==='backupPage')return {ok:true,page:rsBackupPage(db,m,p),revision:m.revision};stage='validate';if(['command','restoreStart','restorePage'].indexOf(action)>=0){rejectLocalAttachments(p);rejectLocalProduction(action,p);}if(action==='command'){var result=rsCommand(db,m,p);return {ok:true,revision:result.meta.revision,affectedIds:result.affected,replayed:result.replayed,mode:'google-test'};}if(action==='restoreStart')return rsRestoreStart(db,m,p);if(action==='restorePage')return rsRestorePage(db,m,p);if(action==='restoreValidatePage')return rsRestoreValidate(db,m,p);if(action==='restorePublish')return rsRestorePublish(db,m,p);if(action==='backup'||action==='restore')throw Error('확장 저장소는 페이지 백업/단계 복원 API를 사용하세요');throw Error('지원하지 않는 API');}catch(e){return {ok:false,error:String(e.message||e),errorCode:e.errorCode||(stage==='read'?'READ_UNAVAILABLE':'VALIDATION_ERROR'),retryable:!!e.retryable||stage==='read',retry:'같은 요청키와 내용으로 재시도 또는 상태 재조회'};}finally{if(held)lock.releaseLock();}}
